{
  "name": "Regional emergency readiness portfolio",
  "domain": "Emergency management / disaster response",
  "context": "A regional resilience authority renews its standing response portfolio: 96 assets \u2014 standing teams, equipment caches, mobile units, and standby contracts \u2014 across five hazard lines (flood, wildfire, quake, storm, hazmat) and four subregions, of which 20-24 are funded. Readiness does not add up: when a hazard hits, every asset the authority holds on that line is tasked, and the line performs at the level of the least-ready unit it fields. Portfolio readiness is therefore the WEAKEST hazard line \u2014 a min, not a total \u2014 so a low-readiness asset drags the whole portfolio down, and buying more capability on a strong line cannot move it.",
  "approach": "binary",
  "objectives": [
    {
      "name": "Readiness",
      "direction": "maximize",
      "unit": "0-100 (weakest line)",
      "aggregation": "min"
    },
    {
      "name": "SurgeCapacity",
      "direction": "maximize",
      "unit": "response-hours/72h",
      "aggregation": "sum"
    },
    {
      "name": "Cost",
      "direction": "minimize",
      "unit": "$M/yr",
      "aggregation": "sum"
    },
    {
      "name": "ActivationTime",
      "direction": "minimize",
      "unit": "hours",
      "aggregation": "avg"
    }
  ],
